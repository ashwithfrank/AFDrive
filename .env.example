# Copy this file to .env and edit the values below.
# .env is excluded from Git — never commit real secrets.

# --- Account -----------------------------------------------------------
# Used only the very first time the app starts (when no account exists
# yet in database.db). To change the password later, either delete
# database.db and restart with new values here, or use the account
# settings inside the app once you've added that feature.
AFDRIVE_USERNAME=admin
AFDRIVE_PASSWORD=changeme123

# --- Storage -------------------------------------------------------------
# Where uploaded files are stored on disk. Defaults to storage/user_files
# inside the project folder if not set. On Termux you might point this at
# your shared storage, e.g. /storage/emulated/0/AFDriveFiles
AFDRIVE_STORAGE_PATH=./storage/user_files

# --- Upload limits ---------------------------------------------------------
# Max upload size in bytes. Default below is 2 GB.
AFDRIVE_MAX_UPLOAD_SIZE=2147483648

# --- Server ----------------------------------------------------------------
AFDRIVE_HOST=0.0.0.0
AFDRIVE_PORT=5000

# Never set this to true in normal use — disables Flask's debugger/reloader
# only, keep as false so stack traces are never shown to users.
AFDRIVE_DEBUG=false

# --- Security --------------------------------------------------------------
# Leave unset to auto-generate and persist a random key in
# instance/secret_key.txt on first run. Set explicitly if you prefer to
# manage it yourself (e.g. shared across multiple deployments).
# AFDRIVE_SECRET_KEY=

# Only set to true if you're putting AFDrive behind HTTPS (e.g. via a
# reverse proxy or tunnel). Leave false for plain local Wi-Fi/HTTP use,
# otherwise your session cookie won't be sent and login will loop.
AFDRIVE_FORCE_HTTPS=false

# How many days a login session stays valid before requiring re-login.
AFDRIVE_SESSION_DAYS=7
